# Copy this file to .env and edit it to change settings; docker compose reads .env automatically.

# Host ports, bound to 127.0.0.1. Pick others if these are already taken on your laptop.
HTTPS_PORT=8443
HTTP_PORT=8080
MAILPIT_PORT=8025

# Container time zone (log timestamps only: the Registry shows times in your browser's time zone).
TZ=America/Chicago

# true = CakePHP debug mode: friendlier error pages, plus the DebugKit toolbar (slower).
DEBUG=false

# The image to run. Default: the published multi-architecture image.
IMAGE=ghcr.io/graemevarga/comanage-pe-workshop:5.2.0-1

# Build only (compose.build.yaml): URL path of the application.
# registry-pe matches the v5.2 course material; registry is upstream's default.
COMANAGE_REGISTRY_WEBROOT=registry-pe
