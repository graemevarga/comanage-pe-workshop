# Copy this file to .env and edit it; docker compose reads .env automatically.

# Host ports, bound to 127.0.0.1. Pick others if these are already taken on your laptop.
HTTPS_PORT=8443
HTTP_PORT=8080
MAILPIT_PORT=8025

# Images. The registry image is upstream's 5.2.0 basic-auth image; see docs/at-home.md to build it yourself
# (then set REGISTRY_IMAGE=comanage-registry:5.2.0-basic-auth-1).
REGISTRY_IMAGE=ghcr.io/graemevarga/comanage-registry:5.2.0-basic-auth-1
DATABASE_IMAGE=postgres:17
MAILPIT_IMAGE=axllent/mailpit:v1.31.6

# Database password, used by both the database and the Registry. No single quotes.
DATABASE_PASSWORD=password
