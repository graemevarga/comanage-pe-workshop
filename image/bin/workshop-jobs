#!/bin/bash
#
# Queue runner: every JOB_INTERVAL seconds, run queued Registry jobs (provisioning, identifier
# assignment, group nesting, deletions...) for each active CO, as www-data.
# "bin/cake job -r -c all" is broken in 5.2.0 (it validates against CO 0), so loop over numeric CO ids.
# FileSource full syncs do not need this: "workshop sync" runs them synchronously.
set -uo pipefail

interval="${JOB_INTERVAL:-60}"
url="https://localhost/${COMANAGE_REGISTRY_WEBROOT}/"

until curl -fsk -o /dev/null -A workshop-healthcheck "${url}"; do
    sleep 5
done

cat <<BANNER
==================================================================================
 COmanage Registry PE ${COMANAGE_REGISTRY_VERSION} workshop is ready.
   Registry : https://localhost:${WORKSHOP_HTTPS_PORT}/${COMANAGE_REGISTRY_WEBROOT}/
              Log in with username "admin" and a blank password (platform administrator).
   Mailpit  : http://localhost:${WORKSHOP_MAILPIT_PORT}/
   Helpers  : docker compose exec registry workshop help
==================================================================================
BANNER

while true; do
    co_ids=$(psql -h /run/postgresql -U "${COMANAGE_REGISTRY_DATABASE_USER}" -d "${COMANAGE_REGISTRY_DATABASE}" -Atc \
        "select id from cos where status = 'A' and co_id is null and deleted is not true order by id" 2>/dev/null)
    for co_id in ${co_ids}; do
        # Without COMANAGE_REGISTRY_CONTAINER, CakePHP logs to local/logs/*.log rather than this log.
        out=$(cd "${COMANAGE_REGISTRY_DIR}/app" && env -u COMANAGE_REGISTRY_CONTAINER HOME=/var/www \
              setpriv --reuid=www-data --regid=www-data --init-groups ./bin/cake job -r -c "${co_id}" -m 100 2>&1)
        if [[ -n "${out}" ]]; then
            sed "s/^/[jobs co=${co_id}] /" <<<"${out}"
        fi
    done
    sleep "${interval}"
done
