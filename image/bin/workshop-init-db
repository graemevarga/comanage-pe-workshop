#!/bin/bash
#
# Build-time initialisation (one RUN step in the Dockerfile).
# Creates the PostgreSQL cluster and the Registry database, then either restores the baked checkpoint
# 01-fresh or runs upstream's first start (bin/cake database + setup). Either way the image ships a
# ready, set-up Registry, so containers start in seconds with identical state.
set -euo pipefail

PGBIN=/usr/lib/postgresql/15/bin
PGDATA="${PGDATA:-/var/lib/postgresql/data}"
DB="${COMANAGE_REGISTRY_DATABASE:-registry}"
DB_USER="${COMANAGE_REGISTRY_DATABASE_USER:-registry_user}"
DB_PASSWORD="${COMANAGE_REGISTRY_DATABASE_USER_PASSWORD:-password}"
FRESH=/opt/workshop/checkpoints/01-fresh.dump
STATE_DIR=/var/lib/workshop

as_postgres() { setpriv --reuid=postgres --regid=postgres --init-groups "$@"; }

echo "==> Creating the PostgreSQL 15 cluster in ${PGDATA}"
mkdir -p "${PGDATA}" /run/postgresql "${STATE_DIR}"
chown -R postgres:postgres "$(dirname "${PGDATA}")" /run/postgresql
chmod 0700 "${PGDATA}"
as_postgres "${PGBIN}/initdb" -D "${PGDATA}" -U postgres -E UTF8 --locale=C.UTF-8 \
    --auth-local=trust --auth-host=scram-sha-256 > /dev/null
install -o postgres -g postgres -m 0600 /opt/workshop/postgres/pg_hba.conf "${PGDATA}/pg_hba.conf"
cat /opt/workshop/postgres/workshop.conf >> "${PGDATA}/postgresql.conf"

as_postgres "${PGBIN}/pg_ctl" -D "${PGDATA}" -w -t 60 -l /tmp/postgres-init.log start
trap 'as_postgres "${PGBIN}/pg_ctl" -D "${PGDATA}" -m fast -w stop || true' EXIT

echo "==> Creating role ${DB_USER} and database ${DB}"
as_postgres psql -v ON_ERROR_STOP=1 -q -U postgres -d postgres \
    -v db="${DB}" -v db_user="${DB_USER}" -v db_password="${DB_PASSWORD}" <<'SQL'
CREATE ROLE :"db_user" LOGIN PASSWORD :'db_password';
CREATE DATABASE :"db" OWNER :"db_user" ENCODING 'UTF8' TEMPLATE template0;
SQL

if [[ -f "${FRESH}" ]]; then
    echo "==> Restoring baked checkpoint 01-fresh"
    as_postgres pg_restore --exit-on-error --no-owner --no-privileges --role="${DB_USER}" \
        -U postgres -d "${DB}" "${FRESH}"
fi

echo "==> Running upstream's container start (database schema, setup, caches)"
/usr/local/bin/workshop-entrypoint true

echo "==> Verifying the Registry is set up"
cd "${COMANAGE_REGISTRY_DIR}/app"
if setup_out=$(setpriv --reuid=www-data --regid=www-data --init-groups ./bin/cake test -t setup 2>&1); then
    echo "ERROR: 'bin/cake test -t setup' reports that setup has NOT run:" >&2
    echo "${setup_out}" >&2
    exit 1
fi
grep -q 'Setup appears to have already run' <<<"${setup_out}" \
    || { echo "ERROR: unexpected 'bin/cake test -t setup' output:" >&2; echo "${setup_out}" >&2; exit 1; }
admin_ok=$(as_postgres psql -U postgres -d "${DB}" -Atc \
    "select count(*) from identifiers where identifier = '${COMANAGE_REGISTRY_ADMIN_USERNAME}' and login = true and status = 'A' and person_id is not null and identifier_id is null and deleted is not true")
if [[ "${admin_ok}" != "1" ]]; then
    echo "ERROR: expected one active login identifier '${COMANAGE_REGISTRY_ADMIN_USERNAME}', found ${admin_ok}" >&2
    exit 1
fi

echo "==> Checking the Apache configuration"
apache2ctl -t

as_postgres "${PGBIN}/pg_ctl" -D "${PGDATA}" -m fast -w stop
trap - EXIT

# Leave nothing root-owned that www-data must write, and no stale runtime files.
chown -R www-data:www-data "${COMANAGE_REGISTRY_DIR}/local"
rm -rf "${COMANAGE_REGISTRY_DIR}/local/tmp/cache/"*/* /tmp/postgres-init.log /tmp/sess_* || true
state="bare (setup only)"
if [[ -f "${FRESH}" ]]; then state="01-fresh"; fi
echo "${state}" > "${STATE_DIR}/current-checkpoint"
echo "==> Workshop database initialised (state: ${state})"
