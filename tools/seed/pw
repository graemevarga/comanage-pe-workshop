#!/bin/bash
# Run a seeder script in the Playwright container, on the workshop's compose network.
# Usage: tools/seed/pw SCRIPT.py [args...]   (env: BASE, OUT, REG_USER are passed through)
# Headless only: the container has no display, and a headed browser hangs on clicks and screenshots.
set -euo pipefail
export MSYS_NO_PATHCONV=1   # Git Bash: keep "-w /seed" and "/seed" mounts as they are (the seeder is meant for WSL, macOS, Linux)
here="$(cd "$(dirname "$0")" && pwd)"
docker image inspect cpw-seed:1.64.0 > /dev/null 2>&1 || docker build -q -t cpw-seed:1.64.0 "${here}" > /dev/null
mkdir -p "${here}/out"
exec docker run --rm --network "${NETWORK:-comanage-pe-workshop_default}" --user "$(id -u):$(id -g)" -e HOME=/tmp \
    -e BASE="${BASE:-https://registry/registry}" -e OUT="${OUT:-out}" -e REG_USER="${REG_USER:-admin}" \
    -v "${here}:/seed" -w /seed cpw-seed:1.64.0 python "$@"
